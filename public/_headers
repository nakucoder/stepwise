# Cloudflare Pages response headers. See "Deploy" in CLAUDE.md.
# The sha256 in script-src allows the no-flash script in index.html. `npm run check` fails if
# that script changes without this hash being updated.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-PMDR2kr/7vZs/uPUXAPv8bKYM9iJkQxPoN5Kto9iud8='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cache-Control: no-cache

# Vite puts a content hash in every file name here, so a changed file always gets a new URL.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
